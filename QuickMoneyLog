    // Owner-only ads: edit this list directly in the code before sharing!
    const ADS = [
      {
        title: 'Smart Zero-Fee Savings Account',
        body: 'Earn up to 6.5% p.a. on your idle cash with instant transfers.'
      },
      {
        title: 'Track Every Rupee, Dol
